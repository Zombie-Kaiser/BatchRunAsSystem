@echo off
rem ---------------------------------------------------------------------------
rem  BatchRunAsSystem v1.0
rem
rem  1:1 batch port of PowerRunAsSystem
rem  Original author: Jean-Pierre LESUEUR (@DarkCoderSc)
rem  https://github.com/PhrozenIO/PowerRunAsSystem
rem  License: Apache License 2.0 (see LICENSE file)
rem
rem  Impersonate the NT AUTHORITY/SYSTEM user and execute commands or launch
rem  interactive processes using only native Windows features (Task Scheduler,
rem  certutil, PowerShell). No third-party tools required.
rem
rem  Actions:
rem    command      Run a non-interactive command as SYSTEM (Task Scheduler)
rem    process      Launch an interactive SYSTEM process on the active desktop
rem    shell        Shortcut: interactive SYSTEM console (cmd.exe by default)
rem    impersonate  Launch an interactive SYSTEM console (see note below)
rem    status       Show current user and elevation state
rem
rem  Usage:
rem    BatchRunAsSystem.bat command [-Application app] [-Argument args]
rem    BatchRunAsSystem.bat process [-CommandLine cmd] [-Hide] [-RedirectKind None/Bind/Reverse] [-Address ip] [-Port port]
rem    BatchRunAsSystem.bat shell [commandline]
rem    BatchRunAsSystem.bat impersonate
rem    BatchRunAsSystem.bat status
rem
rem  Notes:
rem    - An elevated terminal is required.
rem    - "command" default writes whoami output to C:\result.txt
rem    - RedirectKind Bind/Reverse redirect stdin/stdout/stderr of the SYSTEM
rem      process to a socket (useful for SSH/WinRM sessions without desktop).
rem      Reverse: start a listener first. Bind: script waits for one connection.
rem    - "impersonate": token impersonation (PowerShell module feature) cannot
rem      work from a batch context, so an interactive SYSTEM console is opened
rem      instead; exit it to "revert".
rem    - cmd.exe quoting has limits: argument values containing both
rem      double-quotes and an ampersand may need manual adjustments.
rem ---------------------------------------------------------------------------
setlocal EnableExtensions EnableDelayedExpansion

set "PAYLOAD=%SystemRoot%\Temp\BatchRunAsSystem_payload.ps1"
set "CFG=%SystemRoot%\Temp\BatchRunAsSystem.cfg"
set "B64=%SystemRoot%\Temp\BatchRunAsSystem_payload.b64"
set "ERRLOG=%SystemRoot%\Temp\BatchRunAsSystem.err"

set "ACTION=%~1"

if "%ACTION%"=="" goto :usage
if /i "%ACTION%"=="command" goto :do_command
if /i "%ACTION%"=="process" goto :do_process
if /i "%ACTION%"=="shell" goto :do_shell
if /i "%ACTION%"=="impersonate" goto :do_impersonate
if /i "%ACTION%"=="status" goto :do_status
if /i "%ACTION%"=="help" goto :usage
if /i "%ACTION%"=="/h" goto :usage
if /i "%ACTION%"=="-h" goto :usage
goto :usage

:usage
echo BatchRunAsSystem - run commands or processes as NT AUTHORITY SYSTEM.
echo.
echo   BatchRunAsSystem.bat command [-Application app] [-Argument args]
echo   BatchRunAsSystem.bat process [-CommandLine cmd] [-Hide] [-RedirectKind None/Bind/Reverse] [-Address ip] [-Port port]
echo   BatchRunAsSystem.bat shell [commandline]
echo   BatchRunAsSystem.bat impersonate
echo   BatchRunAsSystem.bat status
echo.
echo Examples:
echo   BatchRunAsSystem.bat command -Application cmd.exe -Argument "/c whoami > C:\result.txt"
echo   BatchRunAsSystem.bat process -CommandLine cmd.exe
echo   BatchRunAsSystem.bat shell
exit /b 0

:do_command
shift
set "APP=powershell.exe"
set "ARGS="
:parse_command
if "%~1"=="" goto :run_command
if /i "%~1"=="-Application" (
    set "APP=%~2"
    shift
    shift
    goto :parse_command
)
if /i "%~1"=="-Argument" (
    set "ARGS=%~2"
    shift
    shift
    goto :parse_command
)
echo [ERROR] Unknown parameter: "%~1"
goto :fail
:run_command
call :RequireAdmin || goto :fail
if not defined ARGS set "ARGS=-Command "whoami ^| Out-File C:\result.txt""
set "TR=!APP!"
if not "!ARGS!"=="" set "TR=!TR! !ARGS!"
call :GenRandomString TASKNAME
schtasks /Create /F /TN "!TASKNAME!" /TR "!TR!" /SC ONCE /ST 23:59 /RU SYSTEM >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Failed to register scheduled task.
    goto :fail
)
schtasks /Run /TN "!TASKNAME!" >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Failed to start scheduled task.
    schtasks /Delete /TN "!TASKNAME!" /F >nul 2>&1
    goto :fail
)
schtasks /Delete /TN "!TASKNAME!" /F >nul 2>&1
echo [+] System command dispatched as SYSTEM:
echo     !TR!
goto :done

:do_process
shift
set "P_CMDLINE=powershell.exe"
set "P_HIDE=0"
set "P_REDIRECT=None"
set "P_ADDRESS="
set "P_PORT="
:parse_process
if "%~1"=="" goto :check_process
if /i "%~1"=="-CommandLine" (
    set "P_CMDLINE=%~2"
    shift
    shift
    goto :parse_process
)
if /i "%~1"=="-Hide" (
    set "P_HIDE=1"
    shift
    goto :parse_process
)
if /i "%~1"=="-RedirectKind" (
    set "P_REDIRECT=%~2"
    shift
    shift
    goto :parse_process
)
if /i "%~1"=="-Address" (
    set "P_ADDRESS=%~2"
    shift
    shift
    goto :parse_process
)
if /i "%~1"=="-Port" (
    set "P_PORT=%~2"
    shift
    shift
    goto :parse_process
)
echo [ERROR] Unknown parameter: "%~1"
goto :fail
:check_process
if /i not "%P_REDIRECT%"=="None" if /i not "%P_REDIRECT%"=="Bind" if /i not "%P_REDIRECT%"=="Reverse" (
    echo [ERROR] Invalid -RedirectKind value: "%P_REDIRECT%"
    goto :fail
)
:run_process
call :RequireAdmin || goto :fail
call :WritePayload || goto :fail
call :WriteConfig || goto :fail
call :GenRandomString TASKNAME
powershell -NoProfile -Command "try { Register-ScheduledTask -Force -TaskName '!TASKNAME!' -User 'NT AUTHORITY\SYSTEM' -Action (New-ScheduledTaskAction -Execute 'powershell.exe' -Argument '-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File !PAYLOAD!') -ErrorAction Stop | Out-Null } catch { exit 1 }" >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Failed to register scheduled task.
    goto :fail
)
schtasks /Run /TN "!TASKNAME!" >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Failed to start scheduled task.
    schtasks /Delete /TN "!TASKNAME!" /F >nul 2>&1
    goto :fail
)
schtasks /Delete /TN "!TASKNAME!" /F >nul 2>&1
echo [+] Interactive SYSTEM process dispatched:
echo     !P_CMDLINE!
goto :done

:do_shell
set "P_CMDLINE=%~2"
set "P_HIDE=0"
set "P_REDIRECT=None"
set "P_ADDRESS="
set "P_PORT="
if "%P_CMDLINE%"=="" set "P_CMDLINE=cmd.exe"
goto :run_process

:do_impersonate
echo [i] Token impersonation is not possible from batch (requires in-process WinAPI calls).
echo [i] Launching an interactive SYSTEM console instead. Type "exit" to close it.
set "P_CMDLINE=cmd.exe"
set "P_HIDE=0"
set "P_REDIRECT=None"
set "P_ADDRESS="
set "P_PORT="
goto :run_process

:do_status
echo Current User:
whoami
net session >nul 2>&1
if errorlevel 1 (
    echo Elevated: No
) else (
    echo Elevated: Yes
)
exit /b 0

:WritePayload
del /f /q "!PAYLOAD!" >nul 2>&1
del /f /q "!CFG!" >nul 2>&1
del /f /q "!ERRLOG!" >nul 2>&1
> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo 
>> "!B64!" echo IC1FbmNvZGluZyBVVEY4CgogICAgZXhpdCAxCn0KClJlbW92ZS1JdGVtIC1QYXRoICRNeUludm9jYXRpb24uTXlDb21tYW5kLlBhdGggLUZvcmNlIC1FcnJvckFjdGlvbiBTaWxlbnRseUNvbnRpbnVlCgpleGl0IDAK
certutil -f -decode "!B64!" "!PAYLOAD!" >nul 2>&1
if errorlevel 1 (
    del /f /q "!B64!" >nul 2>&1
    echo [ERROR] Failed to decode payload script.
    exit /b 1
)
del /f /q "!B64!" >nul 2>&1
if not exist "!PAYLOAD!" (
    echo [ERROR] Payload script not found after decode.
    exit /b 1
)
exit /b 0

:WriteConfig
> "!CFG!" echo CommandLine=!P_CMDLINE!
>> "!CFG!" echo Hide=!P_HIDE!
>> "!CFG!" echo RedirectKind=!P_REDIRECT!
>> "!CFG!" echo Address=!P_ADDRESS!
>> "!CFG!" echo Port=!P_PORT!
exit /b 0

:RequireAdmin
net session >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Insufficient Privilege: an elevated terminal is required.
    exit /b 1
)
exit /b 0

:GenRandomString
setlocal
set "CHARS=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
set "RESULT="
for /l %%i in (1,1,15) do (
    set /a IDX=!random! %% 62
    for %%j in (!IDX!) do set "RESULT=!RESULT!!CHARS:~%%j,1!"
)
endlocal & set "%~1=%RESULT%"
exit /b 0

:done
exit /b 0

:fail
exit /b 1
